# ShopFusion environment variables — copy to .env and fill in (NEVER commit .env)
#
#   cp .env.example .env

# PostgreSQL connection string (Prisma). Example:
#   postgresql://USER:PASSWORD@HOST:5432/DATABASE
DATABASE_URL="postgresql://shopfusion:<password>@localhost:5432/shopfusion_dev"

# Separate database used ONLY by the test suite (vitest). Tests wipe it.
DATABASE_URL_TEST="postgresql://shopfusion:<password>@localhost:5432/shopfusion_test"

# Auth.js secret — generate a strong one per environment:
#   npx auth secret
AUTH_SECRET=""

# Public base URL of the app (used in emails, metadata)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ---- Payments ----
# MOCK  = safe test mode, no real money moves (default for dev/test)
# STRIPE | RAZORPAY = real providers; requires keys below. Never commit real keys.
PAYMENT_PROVIDER="MOCK"
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
